# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Testnet (Sepolia) ─────────────────────────────────────────────────────────
# RPC endpoint from Alchemy, Infura, or any Sepolia node
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer account (no 0x prefix needed by Hardhat)
# Fund it with Sepolia ETH from https://sepoliafaucet.com
SEPOLIA_PRIVATE_KEY=your_private_key_here

# ── Local node ────────────────────────────────────────────────────────────────
# No env vars needed: the Hardhat node exposes 20 prefunded deterministic
# accounts. Start it with: npm run node
